---
import Base from "../../layouts/Base.astro";

const reports = [
  {
    title: "Surge Repo Activity",
    href: "/reports/surge-repo-activity/",
    blurb:
      "A daily snapshot of every repository under the surge-synthesizer organization: open pull requests, merge and issue activity over the last week and quarter, new contributors, and how old the open issue backlog is in each repo.",
    cadence: "Regenerated daily",
  },
];
---

<Base
  title="Reports — baconpaul"
  description="Automatically generated reports on the projects I work on."
>
  <section class="wrap page">
    <a class="back" href="/">← baconpaul</a>
    <div class="page-head">
      <p class="eyebrow">Reports</p>
      <h1>Reports</h1>
      <p class="lede">
        Automatically generated snapshots of the projects I work on. These are
        built by scripts against the GitHub API and refreshed on a schedule, so
        the numbers are always as of the timestamp on the page itself.
      </p>
    </div>

    <ul class="report-list">
      {
        reports.map((r) => (
          <li>
            <a href={r.href}>
              <span class="row">
                <h2>{r.title}</h2>
                <span class="cadence">{r.cadence}</span>
              </span>
              <p>{r.blurb}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .report-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .report-list > li {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .report-list a {
    display: block;
    padding: 1.35rem 1.5rem;
    text-decoration: none;
    color: inherit;
    border-radius: inherit;
  }
  .report-list a:hover {
    border-color: var(--accent);
  }
  .report-list .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .report-list h2 {
    font-size: 1.25rem;
    margin: 0;
  }
  .report-list a:hover h2 {
    color: var(--accent);
  }
  .report-list .cadence {
    font-size: 0.78rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .report-list p {
    margin: 0.5rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    max-width: 68ch;
  }
</style>
