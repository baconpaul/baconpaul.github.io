---
import Base from "../../layouts/Base.astro";
---

<Base title="Music & Composition — baconpaul">
  <section class="wrap page">
    <a class="back" href="/">← baconpaul</a>
    <div class="page-head">
      <p class="eyebrow">Music &amp; Composition</p>
      <h1>Bands and Releases</h1>
      <p class="lede">
        I am active in a variety of projects and perform and compose music fairly regularly. 
      </p>
    </div>

    <div class="subsection">
      <h2>Leeward</h2>
      <div class="release">
        <a class="release-cover" href="https://www.leewardband.com">
          <img src="/images/covers/leeward.jpg" alt="Leeward" width="160" height="160" loading="lazy" />
        </a>
        <div class="release-body">
          <p>
            Leeward is a 4 person writing rock project in Brooklyn NY.
            Check out <a href="https://www.leewardband.com">our web page</a> for releases,
            upcoming gigs, and more.
          </p>
        </div>
      </div>
      <div class="release">
        <a class="release-cover" href="https://open.spotify.com/album/1B44Wq4AKxyUhFk4JoT4wy">
          <img src="/images/covers/you-made-it.jpg" alt="You Made It album cover" width="160" height="160" loading="lazy" />
        </a>
        <div class="release-body">
          <h3><a href="https://open.spotify.com/album/1B44Wq4AKxyUhFk4JoT4wy">You Made It</a></h3>
          <p class="release-date">November 2026</p>
          <p>
            Our 2026 11 Song LP
          </p>
        </div>
      </div>
    </div>

    <div class="subsection">
      <h2>As Paul Walker</h2>
      <div class="release">
        <a class="release-cover" href="https://open.spotify.com/album/5A7hoxlGTbESNi5RilLNOS">
          <img src="/images/covers/motion-sketches.jpg" alt="Motion // Sketches EP cover" width="160" height="160" loading="lazy" />
        </a>
        <div class="release-body">
          <h3><a href="https://open.spotify.com/album/5A7hoxlGTbESNi5RilLNOS">Motion // Sketches</a></h3>
          <p class="release-date">October 2026</p>
          <p>
            Motion // Sketches is a set of small-instrument-palette studies on the idea of motion,
            repetition, and texture.
          </p>
        </div>
      </div>
      <div class="release">
        <a class="release-cover" href="https://open.spotify.com/album/2uxHrk7jKmFIW2B89pJnVN?si=v-qUWDMDTIGle9pZF7C-Mg">
          <img src="/images/covers/cathedral.jpg" alt="Cathedral, Canyon, Songbird, Subway EP cover" width="160" height="160" loading="lazy" />
        </a>
        <div class="release-body">
          <h3><a href="https://open.spotify.com/album/2uxHrk7jKmFIW2B89pJnVN?si=v-qUWDMDTIGle9pZF7C-Mg">Cathedral, Canyon, Songbird, Subway</a></h3>
          <p class="release-date">February 2026</p>
          <p>
            Cathedral, Canyon, Songbird, Subway is a 4 track ambient EP composed to accompany
            Ye Zhu's Milwaukee installation <a href="https://www.hawthorncontemporary.com/2026">Continuations</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
