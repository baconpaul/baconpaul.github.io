---
import Base from "../../layouts/Base.astro";
---

<Base title="sndstation — baconpaul">
  <section class="wrap page">
    <a class="back" href="/">← baconpaul</a>
    <div class="page-head">
      <p class="eyebrow">sndstation</p>
      <h1>sndstation</h1>
      <p class="lede">
        sndstation is a project initiated by David Viens at Plogue. It makes a
        wide variety of small devices ready for electronic music applications.
        I'm an early contributor to the api, the sdks, the clap interface, and to the app
        infrastructure.
      </p>
    </div>

    <div class="prose">
      <p class="download">
        Read the <a
          href="https://cdm.link/sndstation-linux-distro-for-game-handhelds/"
          target="_blank"
          rel="noopener">CDM article</a
        >
      </p>
      <p>
        <iframe
          style="width:315px;max-width:100%;aspect-ratio:9/16;border:0"
          src="https://www.youtube.com/embed/V-WRcwsgQ_Q"
          title="sndstation by David Viens"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </p>
    </div>
  </section>
</Base>
